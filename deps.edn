{:paths ["src" "resources"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/osaho.git"
         :git/sha "f12591011fd0d55d25c2cfba37364338487e70e3"}
        io.github.kotoba-lang/artifact
        {:git/url "https://github.com/kotoba-lang/artifact.git"
         ;; Advanced 2026-09-09, e6c9cfa8 -> 7e55cc39 (artifact main, forward
         ;; only). `loader-source-sha256` names the loader that has the
         ;; `g:`/`gl:` region forms this file now emits. `build-runtime!`
         ;; compares the reviewed source's sha against this pin and refuses a
         ;; mismatch, so the two move together or every execution fails with
         ;; "native loader source identity mismatch" -- which reads as a
         ;; tampered loader and is a pin skew.
         :git/sha "7e55cc394c58ac0de6d22bd938d0c42b6b4c3438"}
        io.github.kotoba-lang/kotoba-verifier
        {:git/url "https://github.com/kotoba-lang/kotoba-verifier.git"
         :git/sha "83057552f03a8021c6523e8e38ad7439b1953522"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/url "https://github.com/cognitect-labs/test-runner.git"
                                :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
                  :main-opts ["-m" "cognitect.test-runner"]}}}
