 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/osaho.git"
         :git/sha "f12591011fd0d55d25c2cfba37364338487e70e3"}
        io.github.kotoba-lang/artifact
        {:git/url "https://github.com/kotoba-lang/artifact.git"
         ;; Advanced 2026-09-09, e6c9cfa8 -> 7e55cc39 (artifact main, forward
         ;; only). `loader-source-sha256` names the loader that has the
         ;; `g:`/`gl:` region forms this file now emits. `build-runtime!`
         ;; compares the reviewed source's sha against this pin and refuses a
         ;; mismatch, so the two move together or every execution fails with
         ;; "native loader source identity mismatch" -- which reads as a
         ;; tampered loader and is a pin skew.
         ;; Advanced 2026-09-10, 7e55cc39 -> 7bff9bac (artifact main, forward
         ;; only: 10 ahead, 0 behind). The loader that identity names is the
         ;; one a COMMAND runs on -- argv, stdout, stderr -- and its arenas
         ;; are per-run budgets, which is why `:string-pool` now appears in
         ;; every report and why `valid-supervisor-report?` above learns it
         ;; in the same commit. Key-set equality is exact, so these two move
         ;; together or every attested run is rejected as malformed evidence.
         ;; Corrected 2026-09-10, 7bff9bac -> 97cd1e33: 7bff9bac's docstring
         ;; closed early on a raw quote and did not compile.
         ;; Advanced 2026-09-10, 97cd1e33 -> 15f488d2: the WINDOWS loader
         ;; identity now names a loader that reports :string-pool, which the
         ;; validator above requires of every report. Both loaders must move
         ;; before either can pair with this file.
         :git/sha "15f488d2673b81993a41d7f35b51d6fd879b8490"}
        io.github.kotoba-lang/kotoba-verifier
        {:git/url "https://github.com/kotoba-lang/kotoba-verifier.git"
         :git/sha "83057552f03a8021c6523e8e38ad7439b1953522"}}
